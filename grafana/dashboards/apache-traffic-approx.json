          "datasource": { "type": "loki", "uid": "apache-loki" },
          "editorMode": "code",
          "queryType": "range",
          "legendFormat": "bytes",
          "expr": "sum(sum_over_time({job=\"apache\", log_type=\"access\", host=\"$host\", vhost=~\"${vhost:regex}\", method=~\"${method:regex}\", status=~\"${status:regex}\"} | remote_addr =~ \"$ip\" | path =~ \"$path\" | user_agent =~ \"$ua\" | bytes =~ \"[0-9]+\" | unwrap bytes [$__auto]))"
        }
      ]
    },
    {
      "id": 11,
      "type": "piechart",
      "title": "Top 10 client IPs",
      "description": "Slices are the top 10 IPs only, so they do not sum to total traffic -- percentages are shares of these 10, not of all requests.",
      "datasource": { "type": "loki", "uid": "apache-loki" },
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": [], "fields": "", "values": true },
        "pieType": "pie",
        "displayLabels": ["percent"],
        "legend": { "displayMode": "list", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "apache-loki" },
          "editorMode": "code",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "legendFormat": "{{remote_addr}}",
          "expr": "approx_topk(10, sum by (remote_addr) (count_over_time({job=\"apache\", log_type=\"access\", host=\"$host\", vhost=~\"${vhost:regex}\", method=~\"${method:regex}\", status=~\"${status:regex}\"} | remote_addr =~ \"$ip\" | path =~ \"$path\" | user_agent =~ \"$ua\" [$__range])))"
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Top 10 paths",
      "description": "Query strings are stripped (path_base) to keep the grouping readable.",
      "datasource": { "type": "loki", "uid": "apache-loki" },
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 20 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "mappings": [] },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Requests", "desc": true }],
        "footer": { "show": false, "reducer": ["sum"], "fields": "" }
      },
      "transformations": [
        { "id": "reduce", "options": { "reducers": ["lastNotNull"] } },
        {
          "id": "organize",
          "options": {
            "renameByName": { "Field": "Path", "Last *": "Requests" },
            "excludeByName": {}
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "apache-loki" },
          "editorMode": "code",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "legendFormat": "{{path_base}}",
          "expr": "approx_topk(10, sum by (path_base) (count_over_time({job=\"apache\", log_type=\"access\", host=\"$host\", vhost=~\"${vhost:regex}\", method=~\"${method:regex}\", status=~\"${status:regex}\"} | remote_addr =~ \"$ip\" | path =~ \"$path\" | user_agent =~ \"$ua\" [$__range])))"
        }
      ]
    },
    {
