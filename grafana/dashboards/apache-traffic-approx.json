          "instant": true,
          "range": false,
          "legendFormat": "{{user_agent}}",
          "expr": "approx_topk(10, sum by (user_agent) (count_over_time({job=\"apache\", log_type=\"access\", host=\"$host\", vhost=~\"${vhost:regex}\", method=~\"${method:regex}\", status=~\"${status:regex}\"} | remote_addr =~ \"$ip\" | path =~ \"$path\" | user_agent =~ \"$ua\" [$__range])))"
        }
      ]
    },
    {
      "id": 14,
      "type": "logs",
      "title": "Requests",
      "description": "Raw access log lines matching the filters. Expand a line to see the parsed fields (client IP, path, user agent, bytes) as structured metadata.",
      "datasource": { "type": "loki", "uid": "apache-loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 29 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "apache-loki" },
          "editorMode": "code",
          "queryType": "range",
          "maxLines": 1000,
          "expr": "{job=\"apache\", log_type=\"access\", host=\"$host\", vhost=~\"${vhost:regex}\", method=~\"${method:regex}\", status=~\"${status:regex}\"} | remote_addr =~ \"$ip\" | path =~ \"$path\" | user_agent =~ \"$ua\""
        }
      ]
    },
    {
      "id": 15,
      "type": "logs",
      "title": "Apache error log",
