{
  "uid": "apache-traffic-approx",
  "title": "Apache Traffic (approx)",
  "description": "Same as Apache Traffic, but the three Top 10 panels use approx_topk() instead of topk(). Their counts are approximate -- ranking between values with near-identical traffic can differ -- in exchange for working over ranges where exact grouping exceeds max_query_series (a 5-minute window alone holds ~19k distinct client IPs). Requires shard_aggregations: [approx_topk] in loki/config.yml.",
  "tags": ["apache", "logs", "traffic", "approx"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "1h"]
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": { "type": "loki", "uid": "apache-loki" },
        "query": {
          "label": "host",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{job=\"apache\"}",
          "type": 1
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "current": {},
        "sort": 1
      },
      {
        "name": "vhost",
        "label": "Vhost",
        "description": "Virtual host the request was served for. Taken from %v where Apache logs it (other_vhosts_access.log), otherwise from the log file name.",
        "type": "query",
        "datasource": { "type": "loki", "uid": "apache-loki" },
        "query": {
          "label": "vhost",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{job=\"apache\", log_type=\"access\"}",
          "type": 1
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": ["All"], "value": ["$__all"] },
        "sort": 1
      },
      {
        "name": "method",
        "label": "Method",
        "type": "query",
        "datasource": { "type": "loki", "uid": "apache-loki" },
        "query": {
          "label": "method",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{job=\"apache\", log_type=\"access\"}",
          "type": 1
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": ["All"], "value": ["$__all"] },
        "sort": 1
      },
      {
        "name": "status",
        "label": "Status",
        "type": "query",
        "datasource": { "type": "loki", "uid": "apache-loki" },
        "query": {
          "label": "status",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{job=\"apache\", log_type=\"access\"}",
          "type": 1
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": ["All"], "value": ["$__all"] },
        "sort": 1
      },
      {
        "name": "ip",
        "label": "Client IP (regex)",
        "type": "textbox",
        "query": ".*",
        "current": { "text": ".*", "value": ".*" },
        "options": []
      },
      {
        "name": "path",
        "label": "Path (regex)",
        "type": "textbox",
        "query": ".*",
        "current": { "text": ".*", "value": ".*" },
        "options": []
      },
      {
        "name": "ua",
        "label": "User agent (regex)",
        "type": "textbox",
        "query": ".*",
        "current": { "text": ".*", "value": ".*" },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total requests",
      "description": "Requests matching the current filters over the selected time range.",
      "datasource": { "type": "loki", "uid": "apache-loki" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "apache-loki" },
          "editorMode": "code",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "expr": "sum(count_over_time({job=\"apache\", log_type=\"access\", host=\"$host\", vhost=~\"${vhost:regex}\", method=~\"${method:regex}\", status=~\"${status:regex}\"} | remote_addr =~ \"$ip\" | path =~ \"$path\" | user_agent =~ \"$ua\" [$__range])) or vector(0)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Unique client IPs",
      "description": "Distinct source addresses seen in the selected range, after filtering.",
      "datasource": { "type": "loki", "uid": "apache-loki" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "apache-loki" },
          "editorMode": "code",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "expr": "count(sum by (remote_addr) (count_over_time({job=\"apache\", log_type=\"access\", host=\"$host\", vhost=~\"${vhost:regex}\", method=~\"${method:regex}\", status=~\"${status:regex}\"} | remote_addr =~ \"$ip\" | path =~ \"$path\" | user_agent =~ \"$ua\" [$__range]))) or vector(0)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error rate",
      "description": "Share of filtered requests answered with a 4xx or 5xx status.",
      "datasource": { "type": "loki", "uid": "apache-loki" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "orange", "value": 20 },
              { "color": "red", "value": 50 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "apache-loki" },
          "editorMode": "code",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "expr": "100 * (sum(count_over_time({job=\"apache\", log_type=\"access\", host=\"$host\", vhost=~\"${vhost:regex}\", method=~\"${method:regex}\", status=~\"${status:regex}\", status=~\"[45]..\"} | remote_addr =~ \"$ip\" | path =~ \"$path\" | user_agent =~ \"$ua\" [$__range])) or vector(0)) / sum(count_over_time({job=\"apache\", log_type=\"access\", host=\"$host\", vhost=~\"${vhost:regex}\", method=~\"${method:regex}\", status=~\"${status:regex}\"} | remote_addr =~ \"$ip\" | path =~ \"$path\" | user_agent =~ \"$ua\" [$__range]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Bytes sent",
      "description": "Sum of Apache's %O (bytes sent including headers) over the range.",
      "datasource": { "type": "loki", "uid": "apache-loki" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "text" },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "apache-loki" },
          "editorMode": "code",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "expr": "sum(sum_over_time({job=\"apache\", log_type=\"access\", host=\"$host\", vhost=~\"${vhost:regex}\", method=~\"${method:regex}\", status=~\"${status:regex}\"} | remote_addr =~ \"$ip\" | path =~ \"$path\" | user_agent =~ \"$ua\" | bytes =~ \"[0-9]+\" | unwrap bytes [$__range])) or vector(0)"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "4xx",
      "description": "Client errors (not found, forbidden, bad request, ...).",
      "datasource": { "type": "loki", "uid": "apache-loki" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "apache-loki" },
          "editorMode": "code",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "expr": "sum(count_over_time({job=\"apache\", log_type=\"access\", host=\"$host\", vhost=~\"${vhost:regex}\", method=~\"${method:regex}\", status=~\"${status:regex}\", status=~\"4..\"} | remote_addr =~ \"$ip\" | path =~ \"$path\" | user_agent =~ \"$ua\" [$__range])) or vector(0)"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "5xx",
      "description": "Server errors. Anything non-zero here is worth investigating in the error log panel below.",
      "datasource": { "type": "loki", "uid": "apache-loki" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "apache-loki" },
          "editorMode": "code",
          "queryType": "instant",
          "instant": true,
          "range": false,
          "expr": "sum(count_over_time({job=\"apache\", log_type=\"access\", host=\"$host\", vhost=~\"${vhost:regex}\", method=~\"${method:regex}\", status=~\"${status:regex}\", status=~\"5..\"} | remote_addr =~ \"$ip\" | path =~ \"$path\" | user_agent =~ \"$ua\" [$__range])) or vector(0)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests over time",
      "datasource": { "type": "loki", "uid": "apache-loki" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "barAlignment": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "apache-loki" },
          "editorMode": "code",
          "queryType": "range",
          "legendFormat": "requests",
          "expr": "sum(count_over_time({job=\"apache\", log_type=\"access\", host=\"$host\", vhost=~\"${vhost:regex}\", method=~\"${method:regex}\", status=~\"${status:regex}\"} | remote_addr =~ \"$ip\" | path =~ \"$path\" | user_agent =~ \"$ua\" [$__auto]))"
        }
      ]
    },
    {
      "id": 8,
      "type": "piechart",
      "title": "HTTP methods",
      "datasource": { "type": "loki", "uid": "apache-loki" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "fieldConfig": {
        "defaults": { "unit": "short", "mappings": [] },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "pieType": "donut",
        "displayLabels": ["percent"],
        "legend": { "displayMode": "list", "placement": "right", "showLegend": true }
      },
      "targets": [
        {
          "refId": "A",
